<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SugarPal" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/color_green</item>
        <item name="colorPrimaryDark">@color/color_title_dark</item>
        <item name="colorAccent">@color/color_blue</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:windowBackground">@color/color_bg</item>
        <item name="android:statusBarColor">@color/color_header</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SugarPalTitle">
        <item name="android:textColor">@color/color_title</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SugarPalLabel">
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
